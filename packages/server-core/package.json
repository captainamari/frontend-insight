{
  "name": "@frontend-insight/server-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:m5": "tsx scripts/seed-m5.ts",
    "seed:m6": "tsx scripts/seed-m6.ts",
    "seed:r0": "tsx scripts/seed-v18-r0.ts",
    "verify:r1a": "tsx test/r1a-integration.ts",
    "verify:r1b": "tsx test/r1b-integration.ts",
    "verify:flow": "tsx test/integration-flow.ts",
    "verify:r1c": "tsx test/r1c-preflight-integration.ts && tsx test/r1c-integration.ts",
    "verify:r2": "tsx test/r2-integration.ts",
    "verify:r3": "tsx test/r3-integration.ts"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@frontend-insight/event-contract": "workspace:*",
    "bcryptjs": "3.0.3",
    "jose": "6.2.3",
    "kafkajs": "2.2.4",
    "mysql2": "3.23.1"
  },
  "devDependencies": {
    "@frontend-insight/test-fixtures": "workspace:*",
    "tsx": "4.23.1"
  }
}
