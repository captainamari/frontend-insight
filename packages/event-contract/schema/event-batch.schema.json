{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-insight.internal/schemas/event-batch-v1.json",
  "title": "Frontend Insight Event Batch v1",
  "description": "Browser-to-ingestion transport contract. accountRef must be HMACed and removed before Kafka.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectKey", "sentAt", "sdk", "events"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectKey": {
      "type": "string",
      "pattern": "^fi_public_[A-Za-z0-9_-]{8,64}$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "sdk": {
      "$ref": "#/$defs/sdk"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "propertiesBag": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/propertyValue"
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventName",
        "eventTime",
        "visitorId",
        "sessionId",
        "pageViewId",
        "route",
        "properties"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^evt_[A-Za-z0-9_-]{8,64}$"
        },
        "eventName": {
          "anyOf": [
            {
              "enum": [
                "page_view",
                "page_leave",
                "feature_exposed",
                "feature_started",
                "feature_succeeded",
                "feature_failed",
                "feature_long_view_started",
                "feature_long_view_heartbeat",
                "feature_long_view_ended"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?!page_|feature_)[a-z][a-z0-9_]{0,63}$"
            }
          ]
        },
        "eventTime": {
          "type": "string",
          "format": "date-time"
        },
        "visitorId": {
          "type": "string",
          "pattern": "^vis_[A-Za-z0-9_-]{8,64}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[A-Za-z0-9_-]{8,64}$"
        },
        "pageViewId": {
          "type": "string",
          "pattern": "^pv_[A-Za-z0-9_-]{8,64}$"
        },
        "accountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "route": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "timezoneOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "featureKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "properties": {
          "$ref": "#/$defs/propertiesBag"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventName": {
                "enum": [
                  "feature_exposed",
                  "feature_started",
                  "feature_succeeded",
                  "feature_failed",
                  "feature_long_view_started",
                  "feature_long_view_heartbeat",
                  "feature_long_view_ended"
                ]
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "featureKey": true
            },
            "required": ["featureKey"]
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "feature_failed"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "reasonCode": true
            },
            "required": ["reasonCode"]
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "enum": [
                  "page_leave",
                  "feature_long_view_heartbeat",
                  "feature_long_view_ended"
                ]
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": ["visibleDurationMs"],
                "properties": {
                  "visibleDurationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
