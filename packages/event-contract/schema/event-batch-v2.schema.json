{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-insight.internal/schemas/event-batch-v2.json",
  "title": "Frontend Insight Event Batch v2",
  "description": "Browser-to-ingestion transport contract with anonymous operation lifecycle correlation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectKey", "sentAt", "sdk", "events"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "projectKey": {
      "type": "string",
      "pattern": "^fi_public_[A-Za-z0-9_-]{8,64}$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "sdk": {
      "$ref": "#/$defs/sdk"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "propertiesBag": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/propertyValue"
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventName",
        "eventTime",
        "visitorId",
        "sessionId",
        "pageViewId",
        "route",
        "properties"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^evt_[A-Za-z0-9_-]{8,64}$"
        },
        "eventName": {
          "anyOf": [
            {
              "enum": [
                "page_view",
                "page_leave",
                "feature_exposed",
                "feature_started",
                "feature_succeeded",
                "feature_failed",
                "feature_canceled",
                "feature_long_view_started",
                "feature_long_view_heartbeat",
                "feature_long_view_ended",
                "error_js",
                "error_resource",
                "error_api",
                "web_vital"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?!page_|feature_)[a-z][a-z0-9_]{0,63}$"
            }
          ]
        },
        "eventTime": {
          "type": "string",
          "format": "date-time"
        },
        "visitorId": {
          "type": "string",
          "pattern": "^vis_[A-Za-z0-9_-]{8,64}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[A-Za-z0-9_-]{8,64}$"
        },
        "pageViewId": {
          "type": "string",
          "pattern": "^pv_[A-Za-z0-9_-]{8,64}$"
        },
        "operationInstanceId": {
          "type": "string",
          "pattern": "^op_[A-Za-z0-9_-]{16,64}$"
        },
        "interactionType": {
          "enum": ["click", "submit", "keyboard", "programmatic", "automatic"]
        },
        "accountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "route": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "timezoneOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "featureKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "properties": {
          "$ref": "#/$defs/propertiesBag"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "error_js"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": [
                  "errorName",
                  "errorMessage",
                  "stackTopFrame",
                  "releaseVersion",
                  "deploymentEnvironment"
                ],
                "properties": {
                  "errorName": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "errorMessage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "stackTopFrame": { "type": "string", "maxLength": 256 },
                  "releaseVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "deploymentEnvironment": {
                    "enum": ["production", "staging", "test", "development"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "error_resource"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": [
                  "resourceType",
                  "requestPath",
                  "releaseVersion",
                  "deploymentEnvironment"
                ],
                "properties": {
                  "resourceType": {
                    "enum": ["script", "stylesheet", "image", "font", "media", "other"]
                  },
                  "requestPath": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 256
                  },
                  "releaseVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "deploymentEnvironment": {
                    "enum": ["production", "staging", "test", "development"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "error_api"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": [
                  "requestMethod",
                  "requestPath",
                  "statusCode",
                  "durationMs",
                  "releaseVersion",
                  "deploymentEnvironment"
                ],
                "properties": {
                  "requestMethod": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD",
                      "OPTIONS",
                      "OTHER"
                    ]
                  },
                  "requestPath": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 256
                  },
                  "statusCode": { "type": "integer", "minimum": 0, "maximum": 599 },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400000
                  },
                  "releaseVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "deploymentEnvironment": {
                    "enum": ["production", "staging", "test", "development"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "web_vital"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": [
                  "vitalName",
                  "vitalValue",
                  "vitalRating",
                  "navigationType",
                  "releaseVersion",
                  "deploymentEnvironment"
                ],
                "properties": {
                  "vitalName": { "enum": ["LCP", "CLS", "INP", "FCP", "TTFB"] },
                  "vitalValue": { "type": "number", "minimum": 0, "maximum": 86400000 },
                  "vitalRating": { "enum": ["good", "needs_improvement", "poor"] },
                  "navigationType": {
                    "enum": [
                      "navigate",
                      "reload",
                      "back_forward",
                      "prerender",
                      "unknown"
                    ]
                  },
                  "releaseVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "deploymentEnvironment": {
                    "enum": ["production", "staging", "test", "development"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "enum": [
                  "feature_exposed",
                  "feature_started",
                  "feature_succeeded",
                  "feature_failed",
                  "feature_canceled",
                  "feature_long_view_started",
                  "feature_long_view_heartbeat",
                  "feature_long_view_ended"
                ]
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "featureKey": true
            },
            "required": ["featureKey"]
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "const": "feature_failed"
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "reasonCode": true
            },
            "required": ["reasonCode"]
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "enum": ["feature_started", "feature_canceled"]
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "operationInstanceId": true
            },
            "required": ["operationInstanceId"]
          }
        },
        {
          "if": {
            "properties": {
              "eventName": {
                "enum": [
                  "page_leave",
                  "feature_long_view_heartbeat",
                  "feature_long_view_ended"
                ]
              }
            },
            "required": ["eventName"]
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "required": ["visibleDurationMs"],
                "properties": {
                  "visibleDurationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
