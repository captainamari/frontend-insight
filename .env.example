# M1 app skeletons fail fast when required keys are absent. Local values only.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
KAFKA_BROKERS=kafka:9092
MYSQL_URL=mysql://m1:m1-mysql-local-only@mysql:3306/frontend_insight_m1
CLICKHOUSE_URL=http://clickhouse:8123
ACCOUNT_HMAC_KEY=replace-with-at-least-32-local-characters

CONSUMER_GROUP_ID=frontend-insight-consumer
CONSUMER_BATCH_SIZE=500

PUBLIC_API_BASE_URL=http://localhost:3000
