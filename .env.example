# Application process configuration. Local values only; never commit production secrets.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
KAFKA_BROKERS=kafka:9092
KAFKA_EVENTS_TOPIC=frontend-insight.events.v1
KAFKA_DLQ_TOPIC=frontend-insight.events.dlq.v1
MYSQL_URL=mysql://frontend_insight:local-only@mysql:3306/frontend_insight
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USERNAME=frontend_insight
CLICKHOUSE_PASSWORD=local-only
CLICKHOUSE_DATABASE=frontend_insight
ACCOUNT_HMAC_KEY=replace-with-at-least-32-local-characters
AUTH_TOKEN_SECRET=replace-with-at-least-32-local-characters
REFRESH_COOKIE_SECURE=false

CONSUMER_GROUP_ID=frontend-insight-consumer
CONSUMER_BATCH_SIZE=500
CONSUMER_FLUSH_TIMEOUT_MS=5000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_PAUSE_MS=30000
CONSUMER_HEALTH_PORT=3200

PUBLIC_API_BASE_URL=http://localhost:3000
