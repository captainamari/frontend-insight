#!/usr/bin/env bash
# Read-only diagnostics. Never prints environment, secrets, container logs or full inspect.
set -u
export LC_ALL=C
project="${1:-frontend-insight-production}"
if [[ ! "$project" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  printf 'Usage: bash scripts/deployment-info [compose-project-name]\n' >&2
  exit 2
fi
section() { printf '\n--- %s ---\n' "$1"; }
run() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '%s: not installed\n' "$1"
  elif command -v timeout >/dev/null 2>&1; then
    timeout 15 "$@" 2>/dev/null || printf '%s: unavailable, denied or timed out\n' "$1"
  else
    "$@" 2>/dev/null || printf '%s: unavailable or denied\n' "$1"
  fi
}
section 'Host (not necessarily the Docker daemon host)'
date -u '+collected_at=%Y-%m-%dT%H:%M:%SZ'
uname -srm
printf 'bash=%s\n' "$BASH_VERSION"
if [[ -r /etc/os-release ]]; then
  awk '/^(ID|VERSION_ID|PRETTY_NAME)=/' /etc/os-release
fi
run getconf GNU_LIBC_VERSION
run getconf _NPROCESSORS_ONLN
if [[ -r /proc/cpuinfo ]]; then
  awk -F: '/^(model name|Hardware)[[:space:]]*:/ {print "cpu=" $2; exit}' /proc/cpuinfo
  awk -F: '/^(flags|Features)[[:space:]]*:/ {
    n=split($2, a, " "); printf "selected_cpu_features=";
    for(i=1;i<=n;i++) if(a[i] ~ /^(sse4_2|avx|avx2|neon|asimd|aes|crc32)$/) printf "%s ",a[i];
    print ""; exit
  }' /proc/cpuinfo
fi
if [[ -r /proc/meminfo ]]; then
  awk '/^(MemTotal|MemAvailable|SwapTotal|SwapFree):/' /proc/meminfo
fi
if [[ "$(uname -s)" == Darwin ]]; then
  run sw_vers
  run sysctl -n hw.memsize
fi
run systemd-detect-virt
run getenforce
run stat -f -c 'cgroup_filesystem=%T' /sys/fs/cgroup
printf 'nofile_soft=%s nofile_hard=%s\n' "$(ulimit -Sn)" "$(ulimit -Hn)"
df -Pk . /tmp 2>/dev/null | awk 'NR == 1 {print "filesystem_capacity(KiB): total used available use%"; next} {print $2, $3, $4, $5}'

section 'Docker tooling and selected daemon properties'
run docker --version
run docker compose version
run docker-compose --version
run docker buildx version
run docker version --format 'client={{.Client.Version}} api={{.Client.APIVersion}} platform={{.Client.Os}}/{{.Client.Arch}} server={{.Server.Version}} api={{.Server.APIVersion}} minApi={{.Server.MinAPIVersion}} platform={{.Server.Os}}/{{.Server.Arch}}'
run docker info --format 'os={{.OSType}} arch={{.Architecture}} kernel={{.KernelVersion}} storage={{.Driver}} cgroupDriver={{.CgroupDriver}} cgroupVersion={{.CgroupVersion}} cpu={{.NCPU}} memoryBytes={{.MemTotal}} security={{json .SecurityOptions}}'

section 'Host development tooling (not required to run the built application images)'
run node --version
if command -v pnpm >/dev/null 2>&1; then
  printf 'pnpm: found; version check skipped to avoid automatic package-manager download\n'
else
  printf 'pnpm: not installed (not required by Docker deployment)\n'
fi
run git --version
run git rev-parse HEAD

section "Selected Compose project: $project (maximum 30 containers)"
if command -v docker >/dev/null 2>&1; then
  # Fixed format excludes commands, env, mounts, healthcheck output and endpoints.
  ids="$(run docker ps -aq --filter "label=com.docker.compose.project=$project")"
  count=0
  while IFS= read -r id; do
    [[ "$id" =~ ^[a-f0-9]{12,64}$ ]] || continue
    count=$((count + 1))
    if [[ "$count" -gt 30 ]]; then
      printf 'Container limit reached; remaining containers omitted.\n'
      break
    fi
    run docker inspect --format 'service={{index .Config.Labels "com.docker.compose.service"}} imageId={{.Image}} status={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} restarts={{.RestartCount}}' "$id"
    image_id="$(run docker inspect --format '{{.Image}}' "$id")"
    if [[ "$image_id" =~ ^sha256:[a-f0-9]{64}$ ]]; then
      run docker image inspect --format 'image_platform={{.Os}}/{{.Architecture}}' "$image_id"
    fi
  done <<< "$ids"
fi
printf '\nAlso provide the failing command, failing stage and redacted error excerpt. No changes were made.\n'
