#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE_COMPOSE_FILE="$ROOT_DIR/infra/compose/m2-m4.compose.yml"
WEB_COMPOSE_FILE="$ROOT_DIR/infra/compose/m5.compose.yml"
PRODUCTION_COMPOSE_FILE="$ROOT_DIR/infra/compose/production.compose.yml"
ENV_FILE="$ROOT_DIR/.env.production"
ENV_EXAMPLE="$ROOT_DIR/.env.production.example"
SECRETS_DIR="${FI_SECRETS_DIR:-$ROOT_DIR/.secrets/production}"
STATE_DIR="$ROOT_DIR/.runtime/production"
BACKUP_ROOT="$ROOT_DIR/backups/production"
PROJECT_NAME="frontend-insight-production"

info() { printf '[frontend-insight:production] %s\n' "$*"; }
fail() { printf '[frontend-insight:production] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: bash scripts/production <command>

Commands:
  init-secrets --confirm-create       Generate six local Docker secret files once
  doctor                              Validate host, secrets and Compose policy
  deploy [release-id]                 Build, migrate and deploy an additive release
  verify                              Check public and internal readiness endpoints
  synthetic --confirm-synthetic-data  Seed fixtures and run full flow checks
  backup [name]                       Export MySQL, ClickHouse raw events and checksums
  restore <name> --confirm-replace-data
                                      Pre-backup, replace data and restart services
  rollback <release-id> --confirm-rollback
                                      Reuse retained images; never down-migrate data
  status                              Show service health and bounded resource use
  logs [service]                      Show the last 200 bounded Docker log lines
  down                                Stop services and preserve all named volumes
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "Created .env.production; review its non-secret settings before deployment"
  fi
}

compose() {
  local state_release="${FI_RELEASE_ID:-}"
  if [[ -z "$state_release" && -f "$STATE_DIR/current" ]]; then
    state_release="$(< "$STATE_DIR/current")"
  fi
  if [[ -z "$state_release" && -f "$ENV_FILE" ]]; then
    state_release="$(awk -F= '$1 == "FI_RELEASE_ID" { print $2; exit }' "$ENV_FILE")"
  fi
  FI_SECRETS_DIR="$SECRETS_DIR" FI_RELEASE_ID="$state_release" docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    --file "$BASE_COMPOSE_FILE" \
    --file "$WEB_COMPOSE_FILE" \
    --file "$PRODUCTION_COMPOSE_FILE" \
    "$@"
}

secret_files() {
  printf '%s\n' \
    mysql_root_password \
    mysql_password \
    mysql_url \
    clickhouse_password \
    account_hmac_key \
    auth_token_secret
}

assert_secrets() {
  local name value_size mode
  while IFS= read -r name; do
    [[ -f "$SECRETS_DIR/$name" ]] || fail "Missing secret file: $name"
    value_size="$(wc -c < "$SECRETS_DIR/$name" | tr -d ' ')"
    [[ "$value_size" -ge 32 ]] || fail "Secret file is unexpectedly short: $name"
    if stat -f '%Lp' "$SECRETS_DIR/$name" >/dev/null 2>&1; then
      mode="$(stat -f '%Lp' "$SECRETS_DIR/$name")"
    else
      mode="$(stat -c '%a' "$SECRETS_DIR/$name")"
    fi
    [[ "$mode" == "600" || "$mode" == "400" ]] || \
      fail "Secret file $name must use mode 600 or 400; detected $mode"
  done < <(secret_files)
}

init_secrets() {
  [[ "${1:-}" == "--confirm-create" ]] || \
    fail "Secret generation requires --confirm-create"
  require_command openssl
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  local name existing=0
  while IFS= read -r name; do
    [[ -e "$SECRETS_DIR/$name" ]] && existing=$((existing + 1))
  done < <(secret_files)
  [[ "$existing" -eq 0 ]] || \
    fail "Refusing to overwrite an existing or partial secret set in $SECRETS_DIR"

  local mysql_root mysql_password clickhouse_password account_key token_secret
  mysql_root="$(openssl rand -hex 32)"
  mysql_password="$(openssl rand -hex 32)"
  clickhouse_password="$(openssl rand -hex 32)"
  account_key="$(openssl rand -hex 32)"
  token_secret="$(openssl rand -hex 32)"
  umask 077
  printf '%s\n' "$mysql_root" > "$SECRETS_DIR/mysql_root_password"
  printf '%s\n' "$mysql_password" > "$SECRETS_DIR/mysql_password"
  printf 'mysql://frontend_insight:%s@mysql:3306/frontend_insight\n' \
    "$mysql_password" > "$SECRETS_DIR/mysql_url"
  printf '%s\n' "$clickhouse_password" > "$SECRETS_DIR/clickhouse_password"
  printf '%s\n' "$account_key" > "$SECRETS_DIR/account_hmac_key"
  printf '%s\n' "$token_secret" > "$SECRETS_DIR/auth_token_secret"
  ensure_env
  info "Created mode-600 secrets in $SECRETS_DIR; values were not printed"
}

host_memory_bytes() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    sysctl -n hw.memsize
  elif [[ -r /proc/meminfo ]]; then
    awk '/MemTotal/ { print $2 * 1024 }' /proc/meminfo
  else
    printf '0\n'
  fi
}

doctor() {
  ensure_env
  require_command docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker info >/dev/null 2>&1 || fail "Docker engine is not running"
  assert_secrets
  local memory_bytes free_kib
  memory_bytes="$(host_memory_bytes)"
  if [[ "${FI_ALLOW_CONSTRAINED_HOST:-0}" != "1" ]]; then
    [[ "$memory_bytes" -ge 17179869184 ]] || \
      fail "At least 16 GiB host memory is required by the production Compose profile"
  else
    info "Constrained-host mode only validates policy; do not use it for a pilot"
  fi
  free_kib="$(df -Pk "$ROOT_DIR" | awk 'NR==2 { print $4 }')"
  [[ "$free_kib" -ge 20971520 ]] || fail "At least 20 GiB free disk is required"
  compose config --quiet
  if compose config | grep -q 'local-only'; then
    fail "Resolved production Compose still contains a local-only credential"
  fi
  info "Doctor passed: secret files, resource policy, log rotation and Compose are valid"
}

resolved_release() {
  local requested="${1:-}"
  if [[ -n "$requested" ]]; then
    [[ "$requested" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
      fail "Release ID must be a safe image tag"
    printf '%s\n' "$requested"
    return
  fi
  awk -F= '$1 == "FI_RELEASE_ID" { print $2; exit }' "$ENV_FILE"
}

remember_release() {
  local release="$1" current=""
  mkdir -p "$STATE_DIR"
  [[ -f "$STATE_DIR/current" ]] && current="$(< "$STATE_DIR/current")"
  if [[ -n "$current" && "$current" != "$release" ]]; then
    printf '%s\n' "$current" > "$STATE_DIR/previous"
  fi
  printf '%s\n' "$release" > "$STATE_DIR/current"
  chmod 600 "$STATE_DIR/current" "$STATE_DIR/previous" 2>/dev/null || true
}

deploy() {
  doctor
  local release
  release="$(resolved_release "${1:-}")"
  [[ -n "$release" ]] || fail "Set FI_RELEASE_ID or pass a release ID"
  export FI_RELEASE_ID="$release"
  info "Building immutable local images for release $release"
  compose build migrate api consumer web
  compose up --detach --wait --wait-timeout 300 mysql clickhouse kafka
  compose run --rm migrate
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web
  remember_release "$release"
  verify
  info "Release $release is ready; additive migrations are retained for rollback"
}

verify() {
  ensure_env
  require_command docker
  compose exec -T api node -e \
    "Promise.all(['http://127.0.0.1:3000/health/live','http://127.0.0.1:3000/health/ready'].map(async u=>{const r=await fetch(u);if(!r.ok)throw new Error(u+' '+r.status)}))"
  compose exec -T consumer node -e \
    "fetch('http://127.0.0.1:3200/health/ready').then(r=>{if(!r.ok)throw new Error(String(r.status))})"
  compose exec -T web wget --quiet --tries=1 --spider http://127.0.0.1:8080/health
  info "API, dependencies, consumer and web readiness passed"
}

synthetic() {
  [[ "${1:-}" == "--confirm-synthetic-data" ]] || \
    fail "Synthetic fixtures modify the selected project; pass --confirm-synthetic-data"
  ensure_env
  compose --profile synthetic run --rm seed
  compose --profile synthetic run --rm --no-deps verifier
  compose exec -T api node tools/m5-http-smoke.mjs
  compose exec -T api node tools/m6-http-smoke.mjs
  compose exec -T api node tools/m8-http-smoke.mjs
  info "Synthetic M5-M8 product loop passed"
}

checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    shasum -a 256 "$@"
  fi
}

wait_for_zero_lag() {
  local group
  group="$(awk -F= '$1 == "FI_CONSUMER_GROUP_ID" { print $2; exit }' "$ENV_FILE")"
  group="${group:-frontend-insight-production-v1}"
  local attempt description lag
  for attempt in {1..30}; do
    description="$(compose exec -T kafka /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server 127.0.0.1:9092 --describe --group "$group" 2>/dev/null || true)"
    lag="$(awk 'NR > 1 && $6 ~ /^[0-9]+$/ { total += $6; found = 1 } END { if (found) print total; else print -1 }' <<< "$description")"
    [[ "$lag" == "0" ]] && return
    sleep 2
  done
  fail "Consumer group did not reach zero lag before the backup window"
}

resume_after_backup() {
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web >/dev/null
}

backup() {
  ensure_env
  assert_secrets
  local name="${1:-$(date -u +%Y%m%dT%H%M%SZ)}"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail "Unsafe backup name"
  local target="$BACKUP_ROOT/$name"
  [[ ! -e "$target" ]] || fail "Backup already exists: $name"
  mkdir -p "$target"
  chmod 700 "$target"
  info "Quiescing ingestion for a cross-store consistent backup"
  compose stop api web >/dev/null
  trap 'resume_after_backup >/dev/null 2>&1 || true' EXIT
  wait_for_zero_lag
  compose stop consumer >/dev/null
  compose exec -T mysql bash -ec \
    'exec mysqldump -uroot --password="$(cat /run/secrets/mysql_root_password)" --single-transaction --routines --events --add-drop-database --databases frontend_insight' \
    > "$target/mysql.sql"
  compose exec -T clickhouse bash -ec \
    'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "SELECT * FROM raw_events FORMAT Native"' \
    > "$target/raw_events.native"
  local current_release="unknown"
  [[ -f "$STATE_DIR/current" ]] && current_release="$(< "$STATE_DIR/current")"
  printf '{"createdAt":"%s","release":"%s","formatVersion":1}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$current_release" \
    > "$target/metadata.json"
  (cd "$target" && checksum mysql.sql raw_events.native metadata.json > SHA256SUMS)
  chmod 600 "$target"/*
  resume_after_backup
  trap - EXIT
  info "Backup completed: $target"
}

restore() {
  local name="${1:-}" confirmation="${2:-}"
  [[ -n "$name" && "$confirmation" == "--confirm-replace-data" ]] || \
    fail "Usage: restore <name> --confirm-replace-data"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail "Unsafe backup name"
  local source="$BACKUP_ROOT/$name"
  [[ -f "$source/mysql.sql" && -f "$source/raw_events.native" && \
     -f "$source/SHA256SUMS" ]] || fail "Backup is incomplete: $name"
  (cd "$source" && checksum --check SHA256SUMS)
  local safety="pre-restore-$(date -u +%Y%m%dT%H%M%SZ)"
  backup "$safety"
  compose stop api consumer web
  compose exec -T mysql bash -ec \
    'exec mysql -uroot --password="$(cat /run/secrets/mysql_root_password)"' \
    < "$source/mysql.sql"
  compose exec -T clickhouse bash -ec \
    'clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "TRUNCATE TABLE raw_events"; exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "INSERT INTO raw_events FORMAT Native"' \
    < "$source/raw_events.native"
  compose run --rm migrate
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web
  verify
  info "Restored $name; automatic safety backup is $safety"
}

rollback() {
  local release="${1:-}" confirmation="${2:-}"
  [[ "$confirmation" == "--confirm-rollback" ]] || \
    fail "Usage: rollback <release-id> --confirm-rollback"
  release="$(resolved_release "$release")"
  docker image inspect "frontend-insight-app:$release" >/dev/null 2>&1 || \
    fail "Application image is not retained: $release"
  docker image inspect "frontend-insight-web:$release" >/dev/null 2>&1 || \
    fail "Web image is not retained: $release"
  backup "pre-rollback-$(date -u +%Y%m%dT%H%M%SZ)"
  export FI_RELEASE_ID="$release"
  compose up --detach --no-build --force-recreate --wait --wait-timeout 300 \
    api consumer web
  remember_release "$release"
  verify
  info "Rolled application images back to $release; database schema/data were preserved"
}

status() {
  ensure_env
  compose ps
  local ids
  ids="$(compose ps --quiet)"
  if [[ -n "$ids" ]]; then
    docker stats --no-stream \
      --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' $ids
  fi
  [[ -f "$STATE_DIR/current" ]] && info "Current release: $(< "$STATE_DIR/current")"
  [[ -f "$STATE_DIR/previous" ]] && info "Previous release: $(< "$STATE_DIR/previous")"
}

logs() {
  ensure_env
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    case "$service" in mysql|clickhouse|kafka|api|consumer|web) ;; \
      *) fail "Unknown production service: $service" ;; esac
    compose logs --tail 200 "$service"
  else
    compose logs --tail 200
  fi
}

down() {
  ensure_env
  compose down --remove-orphans
  info "Production services stopped; named volumes and retained images were preserved"
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 1; }
shift

case "$command_name" in
  init-secrets) init_secrets "$@" ;;
  doctor) doctor "$@" ;;
  deploy) deploy "$@" ;;
  verify) verify "$@" ;;
  synthetic) synthetic "$@" ;;
  backup) backup "$@" ;;
  restore) restore "$@" ;;
  rollback) rollback "$@" ;;
  status) status "$@" ;;
  logs) logs "$@" ;;
  down) down "$@" ;;
  -h|--help|help) usage ;;
  *) usage; fail "Unknown command: $command_name" ;;
esac
