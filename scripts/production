#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/production-capacity.sh"
BASE_COMPOSE_FILE="$ROOT_DIR/infra/compose/m2-m4.compose.yml"
WEB_COMPOSE_FILE="$ROOT_DIR/infra/compose/m5.compose.yml"
PRODUCTION_COMPOSE_FILE="$ROOT_DIR/infra/compose/production.compose.yml"
ENV_FILE="$ROOT_DIR/.env.production"
ENV_EXAMPLE="$ROOT_DIR/.env.production.example"
SECRETS_DIR="${FI_SECRETS_DIR:-$ROOT_DIR/.secrets/production}"
STATE_DIR="$ROOT_DIR/.runtime/production"
BACKUP_ROOT="$ROOT_DIR/backups/production"
PROJECT_NAME="frontend-insight-production"

info() { printf '[frontend-insight:production] %s\n' "$*"; }
fail() { printf '[frontend-insight:production] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: bash scripts/production <command>

Commands:
  init-secrets --confirm-create       Generate six local Docker secret files once
  secure-secrets --confirm-permissions Fix existing secret ownership without changing values
  bootstrap-admin                     Prompt for first admin (empty database only)
  bootstrap-admin --stdin-json         Read first-admin JSON from stdin, never command arguments
  verify-secrets                      Check non-root secret reads using built images
  doctor                              Validate host, secrets and Compose policy
  deploy [release-id]                 Build, migrate and deploy an additive release
  verify                              Check public and internal readiness endpoints
  synthetic --confirm-synthetic-data  Seed fixtures and run full flow checks
  backup [name]                       Export MySQL, durable ClickHouse facts and checksums
  restore <name> --confirm-replace-data
                                      Pre-backup, replace data and restart services
  rollback <release-id> --confirm-rollback
                                      Reuse retained images; never down-migrate data
  status                              Show service health and bounded resource use
  logs [service]                      Show the last 200 bounded Docker log lines
  down                                Stop services and preserve all named volumes
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "Created .env.production; review its non-secret settings before deployment"
  fi
}

compose() {
  local state_release="${FI_RELEASE_ID:-}"
  if [[ -z "$state_release" && -f "$STATE_DIR/current" ]]; then
    state_release="$(< "$STATE_DIR/current")"
  fi
  if [[ -z "$state_release" && -f "$ENV_FILE" ]]; then
    state_release="$(awk -F= '$1 == "FI_RELEASE_ID" { print $2; exit }' "$ENV_FILE")"
  fi
  FI_SECRETS_DIR="$SECRETS_DIR" FI_RELEASE_ID="$state_release" docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    --file "$BASE_COMPOSE_FILE" \
    --file "$WEB_COMPOSE_FILE" \
    --file "$PRODUCTION_COMPOSE_FILE" \
    "$@"
}

secret_files() {
  printf '%s\n' \
    mysql_root_password \
    mysql_password \
    mysql_url \
    clickhouse_password \
    account_hmac_key \
    auth_token_secret
}

# A dedicated supplemental group grants read access to non-root application users.
# The host directory remains root-only; Compose file secrets preserve host ownership.
secret_gid=10001
file_stat() {
  if [[ "$(uname -s)" == Darwin ]]; then stat -f "$1" "$3"; else stat -c "$2" "$3"; fi
}

assert_secrets() {
  local name value_size
  [[ ! -L "$SECRETS_DIR" ]] || fail "Secret directory must not be a symlink"
  [[ "$(file_stat '%u:%Lp' '%u:%a' "$SECRETS_DIR")" == "0:700" ]] ||
    fail "Secret directory must be root-owned mode 700; use secure-secrets"
  while IFS= read -r name; do
    [[ -f "$SECRETS_DIR/$name" && ! -L "$SECRETS_DIR/$name" ]] || fail "Missing or symlink secret file: $name"
    value_size="$(wc -c < "$SECRETS_DIR/$name" | tr -d ' ')"
    [[ "$value_size" -ge 32 ]] || fail "Secret file is unexpectedly short: $name"
    [[ "$(file_stat '%u:%g:%Lp' '%u:%g:%a' "$SECRETS_DIR/$name")" == "0:$secret_gid:440" ]] ||
      fail "Secret file $name must be root:$secret_gid mode 440; use secure-secrets"
  done < <(secret_files)
}

secure_secrets() {
  [[ "${1:-}" == "--confirm-permissions" ]] || fail "Requires --confirm-permissions; values will be preserved"
  [[ "$EUID" == 0 ]] || fail "Run secret setup with sudo; application containers still run as node"
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || fail "Secret directory missing or symlink"
  local name
  while IFS= read -r name; do
    [[ -f "$SECRETS_DIR/$name" && ! -L "$SECRETS_DIR/$name" ]] || fail "Missing or symlink secret file: $name"
  done < <(secret_files)
  chown 0:0 "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  while IFS= read -r name; do
    chown "0:$secret_gid" "$SECRETS_DIR/$name"
    chmod 440 "$SECRETS_DIR/$name"
  done < <(secret_files)
  assert_secrets
  info "Secret access secured; values unchanged"
}

init_secrets() {
  [[ "${1:-}" == "--confirm-create" ]] || \
    fail "Secret generation requires --confirm-create"
  [[ "$EUID" == 0 ]] || fail "Use sudo for init-secrets"
  require_command openssl
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  local name existing=0
  while IFS= read -r name; do
    [[ -e "$SECRETS_DIR/$name" ]] && existing=$((existing + 1))
  done < <(secret_files)
  [[ "$existing" -eq 0 ]] || \
    fail "Refusing to overwrite an existing or partial secret set in $SECRETS_DIR"

  local mysql_root mysql_password clickhouse_password account_key token_secret
  mysql_root="$(openssl rand -hex 32)"
  mysql_password="$(openssl rand -hex 32)"
  clickhouse_password="$(openssl rand -hex 32)"
  account_key="$(openssl rand -hex 32)"
  token_secret="$(openssl rand -hex 32)"
  umask 077
  printf '%s\n' "$mysql_root" > "$SECRETS_DIR/mysql_root_password"
  printf '%s\n' "$mysql_password" > "$SECRETS_DIR/mysql_password"
  printf 'mysql://frontend_insight:%s@mysql:3306/frontend_insight\n' \
    "$mysql_password" > "$SECRETS_DIR/mysql_url"
  printf '%s\n' "$clickhouse_password" > "$SECRETS_DIR/clickhouse_password"
  printf '%s\n' "$account_key" > "$SECRETS_DIR/account_hmac_key"
  printf '%s\n' "$token_secret" > "$SECRETS_DIR/auth_token_secret"
  secure_secrets --confirm-permissions
  ensure_env
  info "Created root-owned mode-440 secrets in $SECRETS_DIR; values were not printed"
}

doctor() {
  ensure_env
  require_command docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker info >/dev/null 2>&1 || fail "Docker engine is not running"
  local endpoint
  endpoint="${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}"
  [[ "$endpoint" == unix://* ]] || fail "File secrets require a local Docker daemon; remote contexts are unsupported"
  assert_secrets
  local canonical_secrets
  canonical_secrets="$(cd "$SECRETS_DIR" && pwd -P)"
  case "$canonical_secrets/" in
    "$ROOT_DIR/.secrets/"*) ;;
    "$ROOT_DIR/"*) fail "In-repository secrets must be under excluded .secrets/; prefer a directory outside the build context" ;;
  esac
  local memory_bytes free_kib docker_root available_kib
  memory_bytes="$(docker info --format '{{.MemTotal}}')"
  # 16 GiB-class hosts commonly expose less physical RAM after kernel reservations.
  # Keep a 15 GiB usable-total floor, independent of swap, plus bounded service limits.
  if [[ "${FI_ALLOW_CONSTRAINED_HOST:-0}" != "1" ]]; then
    production_capacity_total_ok "$memory_bytes" ||
      fail "Production requires at least 15 GiB Docker daemon RAM (16 GiB-class host); swap does not count"
    free_kib="$(df -Pk "$ROOT_DIR" | awk 'NR==2 { print $4 }')"
    [[ "$free_kib" -ge 20971520 ]] || fail "At least 20 GiB free workspace disk is required"
    docker_root="$(docker info --format '{{.DockerRootDir}}')"
    if [[ -d "$docker_root" ]]; then
      free_kib="$(df -Pk "$docker_root" | awk 'NR==2 { print $4 }')"
      [[ "$free_kib" -ge 20971520 ]] || fail "At least 20 GiB free Docker data disk is required"
    else
      info "Docker data disk is not host-visible; check daemon disk capacity separately"
    fi
  else
    info "Constrained-host mode skips capacity gates for CI only; not production approval"
  fi
  if [[ -r /proc/meminfo ]]; then
    available_kib="$(awk '/MemAvailable:/ { print $2 }' /proc/meminfo)"
    info "Host available RAM: $available_kib KiB; steady service limits total 9.875 GiB, excluding build/transient jobs"
    if [[ "$available_kib" -lt 11534336 ]]; then
      info "WARNING: under 11 GiB available; account for existing containers and avoid concurrent builds/load"
    fi
  fi
  compose config --quiet
  if compose config | grep -q 'local-only'; then
    fail "Resolved production Compose still contains a local-only credential"
  fi
  info "Doctor passed: configuration preflight only; deploy verifies actual container secret access and readiness"
}

check_secret_access() {
  local service
  for service in migrate api consumer; do
    compose run --rm --no-deps --entrypoint node "$service" -e '
      const fs=require("node:fs");
      if(process.getuid()===0) throw new Error("APPLICATION_MUST_BE_NON_ROOT");
      for(const [key,path] of Object.entries(process.env)) if(key.endsWith("_FILE")) {
        try { if(!fs.readFileSync(path,"utf8").trim()) throw Error(); }
        catch { console.error("SECRET_UNREADABLE: "+key); process.exit(1); }
      }
      console.log("Non-root secret access verified");'
  done
}

bootstrap_admin() {
  ensure_env
  assert_secrets
  if [[ "${1:-}" == "--stdin-json" ]]; then
    compose exec -T api node apps/api/dist/bootstrap-admin.js --stdin-json
  elif [[ -z "${1:-}" && -t 0 && -t 1 ]]; then
    compose exec api node apps/api/dist/bootstrap-admin.js --interactive
  else
    fail "Use an interactive terminal or bootstrap-admin --stdin-json (email, displayName, password)"
  fi
}

resolved_release() {
  local requested="${1:-}"
  if [[ -n "$requested" ]]; then
    [[ "$requested" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
      fail "Release ID must be a safe image tag"
    printf '%s\n' "$requested"
    return
  fi
  awk -F= '$1 == "FI_RELEASE_ID" { print $2; exit }' "$ENV_FILE"
}

remember_release() {
  local release="$1" current=""
  mkdir -p "$STATE_DIR"
  [[ -f "$STATE_DIR/current" ]] && current="$(< "$STATE_DIR/current")"
  if [[ -n "$current" && "$current" != "$release" ]]; then
    printf '%s\n' "$current" > "$STATE_DIR/previous"
  fi
  printf '%s\n' "$release" > "$STATE_DIR/current"
  chmod 600 "$STATE_DIR/current" "$STATE_DIR/previous" 2>/dev/null || true
}

deploy() {
  doctor
  local release
  release="$(resolved_release "${1:-}")"
  [[ -n "$release" ]] || fail "Set FI_RELEASE_ID or pass a release ID"
  export FI_RELEASE_ID="$release"
  info "Building immutable local images for release $release"
  compose build migrate api consumer web
  check_secret_access
  compose up --detach --wait --wait-timeout 300 mysql clickhouse kafka
  compose run --rm migrate
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web
  remember_release "$release"
  verify
  info "Release $release is ready; additive migrations are retained for rollback"
}

verify() {
  ensure_env
  require_command docker
  compose exec -T api node -e \
    "Promise.all(['http://127.0.0.1:3000/health/live','http://127.0.0.1:3000/health/ready'].map(async u=>{const r=await fetch(u);if(!r.ok)throw new Error(u+' '+r.status)}))"
  compose exec -T consumer node -e \
    "fetch('http://127.0.0.1:3200/health/ready').then(r=>{if(!r.ok)throw new Error(String(r.status))})"
  compose exec -T web wget --quiet --tries=1 --spider http://127.0.0.1:8080/health
  info "API, dependencies, consumer and web readiness passed"
}

synthetic() {
  [[ "${1:-}" == "--confirm-synthetic-data" ]] || \
    fail "Synthetic fixtures modify the selected project; pass --confirm-synthetic-data"
  ensure_env
  compose --profile synthetic run --rm seed
  compose --profile synthetic run --rm --no-deps verifier
  compose exec -T api node tools/m5-http-smoke.mjs
  compose exec -T api node tools/m6-http-smoke.mjs
  compose exec -T api node tools/m8-http-smoke.mjs
  info "Synthetic M5-M8 product loop passed"
}

checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    shasum -a 256 "$@"
  fi
}

wait_for_zero_lag() {
  local attempt snapshot
  for attempt in {1..30}; do
    if snapshot="$(compose exec -T consumer node tools/kafka-durable-offsets.mjs 2>/dev/null)"; then
      info "Kafka durable offsets caught up: $snapshot"
      return
    fi
    sleep 2
  done
  # This diagnostic contains only topic, partition and offsets, never event payload.
  info "Last durable offset observation: ${snapshot:-unavailable}"
  fail "Consumer group did not reach zero lag before the backup window"
}

resume_after_backup() {
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web >/dev/null
}

backup() {
  ensure_env
  assert_secrets
  local name="${1:-$(date -u +%Y%m%dT%H%M%SZ)}"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail "Unsafe backup name"
  local target="$BACKUP_ROOT/$name"
  [[ ! -e "$target" ]] || fail "Backup already exists: $name"
  mkdir -p "$target"
  chmod 700 "$target"
  info "Quiescing ingestion for a cross-store consistent backup"
  compose stop api web >/dev/null
  trap 'resume_after_backup >/dev/null 2>&1 || true' EXIT
  wait_for_zero_lag
  compose stop consumer >/dev/null
  compose exec -T mysql bash -ec \
    'exec mysqldump -uroot --password="$(cat /run/secrets/mysql_root_password)" --single-transaction --routines --events --add-drop-database --databases frontend_insight --skip-comments --order-by-primary --hex-blob --set-gtid-purged=OFF' \
    > "$target/mysql.sql"
  # Durable projection proofs are required to preserve repeated-operation results.
  # Never back up the short-lived object_operation_refs table (ADR-020).
  for table in raw_events repeated_operation_proofs; do
    compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "$1"' -- \
      "SELECT * FROM $table ORDER BY tuple(*) FORMAT Native" > "$target/$table.native"
    compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "$1"' -- \
      "DESCRIBE TABLE $table FORMAT TSV" > "$target/$table.schema.tsv"
  done
  local current_release="unknown"
  [[ -f "$STATE_DIR/current" ]] && current_release="$(< "$STATE_DIR/current")"
  printf '{"createdAt":"%s","release":"%s","formatVersion":2}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$current_release" \
    > "$target/metadata.json"
  (cd "$target" && checksum mysql.sql *.native *.schema.tsv metadata.json > SHA256SUMS)
  chmod 600 "$target"/*
  resume_after_backup
  trap - EXIT
  info "Backup completed: $target"
}

restore() {
  local name="${1:-}" confirmation="${2:-}"
  [[ -n "$name" && "$confirmation" == "--confirm-replace-data" ]] || \
    fail "Usage: restore <name> --confirm-replace-data"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail "Unsafe backup name"
  local source="$BACKUP_ROOT/$name"
  [[ -f "$source/mysql.sql" && -f "$source/raw_events.native" && \
     -f "$source/SHA256SUMS" ]] || fail "Backup is incomplete: $name"
  (cd "$source" && checksum --check SHA256SUMS)
  # Fail before mutation for pre-R8/incompatible archives; never invent missing proofs.
  for table in raw_events repeated_operation_proofs; do
    [[ -f "$source/$table.native" && -f "$source/$table.schema.tsv" ]] || fail "Backup lacks durable facts/schema: $table"
    compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "$1"' -- \
      "DESCRIBE TABLE $table FORMAT TSV" | cmp -s - "$source/$table.schema.tsv" || fail "Backup schema mismatch: $table; use the matching release before restore"
  done
  local safety="pre-restore-$(date -u +%Y%m%dT%H%M%SZ)"
  backup "$safety"
  compose stop api consumer web
  compose exec -T mysql bash -ec \
    'exec mysql -uroot --password="$(cat /run/secrets/mysql_root_password)"' \
    < "$source/mysql.sql"
  for table in raw_events repeated_operation_proofs; do
    compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "$1"' -- "TRUNCATE TABLE $table"
    compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "$1"' -- \
      "INSERT INTO $table FORMAT Native" < "$source/$table.native"
  done
  # These references are deliberately not recoverable; do not retain facts from a later timeline.
  compose exec -T clickhouse bash -ec 'exec clickhouse-client --user frontend_insight --password "$(cat /run/secrets/clickhouse_password)" --database frontend_insight --query "TRUNCATE TABLE object_operation_refs"'
  compose run --rm migrate
  compose up --detach --no-build --wait --wait-timeout 300 api consumer web
  verify
  info "Restored $name; automatic safety backup is $safety"
}

rollback() {
  local release="${1:-}" confirmation="${2:-}"
  [[ "$confirmation" == "--confirm-rollback" ]] || \
    fail "Usage: rollback <release-id> --confirm-rollback"
  release="$(resolved_release "$release")"
  docker image inspect "frontend-insight-app:$release" >/dev/null 2>&1 || \
    fail "Application image is not retained: $release"
  docker image inspect "frontend-insight-web:$release" >/dev/null 2>&1 || \
    fail "Web image is not retained: $release"
  backup "pre-rollback-$(date -u +%Y%m%dT%H%M%SZ)"
  export FI_RELEASE_ID="$release"
  compose up --detach --no-build --force-recreate --wait --wait-timeout 300 \
    api consumer web
  remember_release "$release"
  verify
  info "Rolled application images back to $release; database schema/data were preserved"
}

status() {
  ensure_env
  compose ps
  local ids
  ids="$(compose ps --quiet)"
  if [[ -n "$ids" ]]; then
    docker stats --no-stream \
      --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' $ids
  fi
  if [[ -f "$STATE_DIR/current" ]]; then info "Current release: $(< "$STATE_DIR/current")"; fi
  if [[ -f "$STATE_DIR/previous" ]]; then info "Previous release: $(< "$STATE_DIR/previous")"; fi
}

logs() {
  ensure_env
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    case "$service" in mysql|clickhouse|kafka|api|consumer|web) ;; \
      *) fail "Unknown production service: $service" ;; esac
    compose logs --tail 200 "$service"
  else
    compose logs --tail 200
  fi
}

down() {
  ensure_env
  compose down --remove-orphans
  info "Production services stopped; named volumes and retained images were preserved"
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 1; }
shift

case "$command_name" in
  init-secrets) init_secrets "$@" ;;
  secure-secrets) secure_secrets "$@" ;;
  bootstrap-admin) bootstrap_admin "$@" ;;
  verify-secrets) ensure_env; check_secret_access ;;
  doctor) doctor "$@" ;;
  deploy) deploy "$@" ;;
  verify) verify "$@" ;;
  synthetic) synthetic "$@" ;;
  backup) backup "$@" ;;
  restore) restore "$@" ;;
  rollback) rollback "$@" ;;
  status) status "$@" ;;
  logs) logs "$@" ;;
  down) down "$@" ;;
  -h|--help|help) usage ;;
  *) usage; fail "Unknown command: $command_name" ;;
esac
