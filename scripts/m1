#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/infra/compose/m1.compose.yml"
ENV_FILE="$ROOT_DIR/.env.m1"
ENV_EXAMPLE="$ROOT_DIR/.env.m1.example"
PROJECT_NAME="frontend-insight-m1"

info() {
  printf '[frontend-insight:m1] %s\n' "$*"
}

fail() {
  printf '[frontend-insight:m1] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: ./scripts/m1 <command>

Commands:
  doctor                         Check Docker, target architecture and config
  up                             Start M1 MySQL and ClickHouse
  migrate [all|mysql|clickhouse] Apply versioned migrations
  verify                         Verify upgrade, idempotency, TTL and fixtures
  status                         Show service health and resource use
  logs [mysql|clickhouse]        Show M1 service logs
  down                           Stop containers and preserve M1 data
  reset --confirm-local-data-loss
                                 Delete only frontend-insight-m1 local data
USAGE
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "Created .env.m1 from .env.m1.example"
  fi
}

compose() {
  docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    --file "$COMPOSE_FILE" \
    "$@"
}

doctor() {
  ensure_env
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker info >/dev/null 2>&1 || fail "Docker engine is not running"

  local host_arch docker_arch free_kib
  host_arch="$(uname -m)"
  docker_arch="$(docker info --format '{{.Architecture}}')"
  if [[ "${M1_ALLOW_NON_ARM64:-0}" != "1" ]]; then
    [[ "$host_arch" == "arm64" ]] || fail "M1 target is Apple Silicon arm64; detected: $host_arch"
    [[ "$docker_arch" == "aarch64" || "$docker_arch" == "arm64" ]] || \
      fail "Docker engine is not arm64: $docker_arch"
  else
    info "Non-arm64 mode enabled for CI (${host_arch}/${docker_arch})"
  fi

  free_kib="$(df -Pk "$ROOT_DIR" | awk 'NR==2 { print $4 }')"
  [[ "$free_kib" -ge 20971520 ]] || fail "At least 20 GiB free disk is required"
  compose config --quiet
  info "Doctor passed: host=${host_arch}, docker=${docker_arch}, compose config=valid"
}

up() {
  doctor
  compose up --detach --wait --wait-timeout 180 mysql clickhouse
  info "M1 databases are healthy"
}

migrate() {
  ensure_env
  local target="${1:-all}"
  case "$target" in all|mysql|clickhouse) ;; *) fail "Unknown engine: $target" ;; esac
  compose build migration-runner
  compose run --rm --no-deps migration-runner pnpm migrate "$target"
}

verify() {
  ensure_env
  compose build migration-runner
  compose run --rm --no-deps migration-runner pnpm migrate:verify
}

status() {
  ensure_env
  compose ps
  local container_ids=()
  mapfile -t container_ids < <(compose ps --quiet)
  if [[ "${#container_ids[@]}" -gt 0 ]]; then
    docker stats --no-stream \
      --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' \
      "${container_ids[@]}"
  fi
}

logs() {
  ensure_env
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    case "$service" in mysql|clickhouse) ;; *) fail "Unknown M1 service: $service" ;; esac
    compose logs --tail 200 "$service"
  else
    compose logs --tail 200
  fi
}

down() {
  ensure_env
  compose down --remove-orphans
  info "M1 containers stopped; named data volumes were preserved"
}

reset() {
  [[ "${1:-}" == "--confirm-local-data-loss" ]] || \
    fail "Reset deletes local M1 data. Re-run with --confirm-local-data-loss"
  ensure_env
  info "Volumes selected by Compose project label before deletion:"
  docker volume ls \
    --filter "label=com.docker.compose.project=$PROJECT_NAME" \
    --format '  {{.Name}}'
  compose down --volumes --remove-orphans
  info "Deleted only frontend-insight-m1 containers and named volumes"
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 1; }
shift

case "$command_name" in
  doctor) doctor "$@" ;;
  up) up "$@" ;;
  migrate) migrate "$@" ;;
  verify) verify "$@" ;;
  status) status "$@" ;;
  logs) logs "$@" ;;
  down) down "$@" ;;
  reset) reset "$@" ;;
  -h|--help|help) usage ;;
  *) usage; fail "Unknown command: $command_name" ;;
esac
