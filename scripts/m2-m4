#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/infra/compose/m2-m4.compose.yml"
ENV_FILE="$ROOT_DIR/.env.m2-m4"
ENV_EXAMPLE="$ROOT_DIR/.env.m2-m4.example"
PROJECT_NAME="frontend-insight-m2-m4"

info() { printf '[frontend-insight:m2-m4] %s\n' "$*"; }
fail() { printf '[frontend-insight:m2-m4] ERROR: %s\n' "$*" >&2; exit 1; }

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "Created .env.m2-m4 from local-only defaults"
  fi
}

compose() {
  docker compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" "$@"
}

doctor() {
  ensure_env
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker info >/dev/null 2>&1 || fail "Docker engine is not running"
  if [[ "${M24_ALLOW_NON_ARM64:-0}" != "1" ]]; then
    [[ "$(uname -m)" == "arm64" ]] || fail "Target is Apple Silicon arm64"
  fi
  compose config --quiet
  info "Doctor passed"
}

up() {
  doctor
  compose up --detach --build --wait --wait-timeout 300 api consumer
  info "API and consumer are ready"
}

verify() { ensure_env; compose run --rm verifier; }
status() { ensure_env; compose ps; }
logs() { ensure_env; compose logs --tail 200 "${1:-api}"; }
down() { ensure_env; compose down --remove-orphans; }

reset() {
  [[ "${1:-}" == "--confirm-local-data-loss" ]] || fail "Re-run with --confirm-local-data-loss"
  ensure_env
  docker volume ls --filter "label=com.docker.compose.project=$PROJECT_NAME" --format '  {{.Name}}'
  compose down --volumes --remove-orphans
  info "Deleted only M2-M4 local containers and volumes"
}

case "${1:-}" in
  doctor) doctor ;;
  up) up ;;
  verify) verify ;;
  status) status ;;
  logs) logs "${2:-}" ;;
  down) down ;;
  reset) reset "${2:-}" ;;
  *) fail "Usage: ./scripts/m2-m4 doctor|up|verify|status|logs [service]|down|reset --confirm-local-data-loss" ;;
esac
