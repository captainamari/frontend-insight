#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE_COMPOSE_FILE="$ROOT_DIR/infra/compose/m2-m4.compose.yml"
M5_COMPOSE_FILE="$ROOT_DIR/infra/compose/m5.compose.yml"
ENV_FILE="$ROOT_DIR/.env.m5"
ENV_EXAMPLE="$ROOT_DIR/.env.m5.example"
PROJECT_NAME="frontend-insight-m5"

info() { printf '[frontend-insight:r0] %s\n' "$*"; }
fail() { printf '[frontend-insight:r0] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: ./scripts/dev <command>

Commands:
  doctor                         Check Docker, Apple Silicon and local resources
  bootstrap                      Create .env.m5 and validate the full Compose config
  up                             Build and start API, consumer, management UI and demo
  seed                           Idempotently create local users, project and features
  smoke                          Verify the data flow and all three HTTP services
  verify-r1a                     Verify R1-A CRUD, isolation, audit and privacy
  status                         Show service health and current resource use
  logs [service]                 Show recent logs for all or one service
  down                           Stop containers and preserve named data volumes
  reset --confirm-local-data-loss
                                 Delete only this local stack and its named data volumes
USAGE
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "Created .env.m5 from local-only defaults"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

compose() {
  docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    --file "$BASE_COMPOSE_FILE" \
    --file "$M5_COMPOSE_FILE" \
    "$@"
}

host_memory_bytes() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    sysctl -n hw.memsize
    return
  fi
  if [[ -r /proc/meminfo ]]; then
    awk '/MemTotal/ { print $2 * 1024 }' /proc/meminfo
    return
  fi
  printf '0\n'
}

doctor() {
  ensure_env
  require_command docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker info >/dev/null 2>&1 || fail "Docker engine is not running"

  local host_arch docker_arch memory_bytes free_kib
  host_arch="$(uname -m)"
  docker_arch="$(docker info --format '{{.Architecture}}')"
  if [[ "${M5_ALLOW_NON_ARM64:-0}" != "1" ]]; then
    [[ "$host_arch" == "arm64" ]] || \
      fail "R0 target is Apple Silicon arm64; detected host architecture: $host_arch"
    [[ "$docker_arch" == "aarch64" || "$docker_arch" == "arm64" ]] || \
      fail "Docker is not using a native arm64 engine: $docker_arch"
  else
    info "Non-arm64 CI mode enabled (${host_arch}/${docker_arch})"
  fi

  memory_bytes="$(host_memory_bytes)"
  if [[ "${M5_ALLOW_NON_ARM64:-0}" != "1" && "$memory_bytes" -lt 17179869184 ]]; then
    fail "At least 16 GiB host memory is required; the accepted M1 Mac has 32 GiB"
  fi
  free_kib="$(df -Pk "$ROOT_DIR" | awk 'NR==2 { print $4 }')"
  [[ "$free_kib" -ge 10485760 ]] || fail "At least 10 GiB free disk space is required"

  for port in 3000 3200 4173 4174; do
    if command -v lsof >/dev/null 2>&1 && \
      lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      info "Warning: port $port is already in use; adjust .env.m5 if needed"
    fi
  done

  compose config --quiet
  info "Doctor passed: host=${host_arch}, docker=${docker_arch}, Compose config=valid"
}

bootstrap() {
  ensure_env
  require_command docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  compose config --quiet
  info "v1.8 R0 local configuration is ready"
}

run_seed() {
  compose run --rm --build seed || return 1
  info "R0 users, project, canonical entities, workflow and metric definitions are ready"
  info "Local admin: admin@example.invalid / LocalAdmin-1234 (ASCII '-' hyphen)"
}

seed() {
  ensure_env
  require_command docker
  run_seed || \
    fail "R0 seed failed. Do not continue to login or acceptance checks; inspect the seed output above."
}

up() {
  doctor
  info "Building and starting the v1.8 R0 local baseline"
  compose up --detach --build --wait --wait-timeout 360 api consumer web demo
  if ! run_seed; then
    compose stop api consumer web demo >/dev/null 2>&1 || true
    fail "R0 startup stopped because seed did not complete"
  fi
  info "Management UI: http://localhost:4173"
  info "Scenario demo: http://localhost:4174"
}

smoke() {
  ensure_env
  require_command docker
  if ! compose run --rm --build --no-deps verifier; then
    fail "R0 smoke failed. The seed snapshot, documented login, or v3 data flow is invalid."
  fi
  info "R0 empty-baseline, contract rejection and canonical data-flow smoke checks passed"
}

verify_r1a() {
  ensure_env
  require_command docker
  if ! compose run --rm --build --no-deps r1a-verifier; then
    fail "R1-A verification failed. Inspect API output and the verifier result above."
  fi
  info "R1-A analysis-object, project-isolation, audit and privacy checks passed"
}

status() {
  ensure_env
  require_command docker
  compose ps
  local container_ids
  container_ids="$(compose ps --quiet)"
  if [[ -n "$container_ids" ]]; then
    docker stats --no-stream \
      --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' \
      $container_ids
  fi
}

logs() {
  ensure_env
  require_command docker
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    case "$service" in
      mysql|clickhouse|kafka-init|kafka|kafka-topics|migrate|api|consumer|web|demo|seed|verifier|r1a-verifier) ;;
      *) fail "Unknown R0 service: $service" ;;
    esac
    compose logs --tail 200 "$service"
    return
  fi
  compose logs --tail 200
}

down() {
  ensure_env
  require_command docker
  compose down --remove-orphans
  info "R0 containers stopped; named data volumes were preserved"
}

reset() {
  [[ "${1:-}" == "--confirm-local-data-loss" ]] || \
    fail "Reset deletes local R0 data. Re-run with --confirm-local-data-loss"
  ensure_env
  require_command docker
  info "Volumes selected by the exact Compose project label:"
  docker volume ls \
    --filter "label=com.docker.compose.project=$PROJECT_NAME" \
    --format '  {{.Name}}'
  compose down --volumes --remove-orphans
  info "Deleted only frontend-insight-m5 containers and named volumes"
}

command_name="${1:-}"
if [[ -z "$command_name" ]]; then
  usage
  exit 1
fi
shift

case "$command_name" in
  doctor) doctor "$@" ;;
  bootstrap) bootstrap "$@" ;;
  up) up "$@" ;;
  seed) seed "$@" ;;
  smoke) smoke "$@" ;;
  verify-r1a) verify_r1a "$@" ;;
  status) status "$@" ;;
  logs) logs "$@" ;;
  down) down "$@" ;;
  reset) reset "$@" ;;
  -h|--help|help) usage ;;
  *) usage; fail "Unknown command: $command_name" ;;
esac
